<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
					<Button Content="Получить пустой бланк"/>
					<Button Content="Составить"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,50" HorizontalAlignment="Right">
					<Button Content="Получить пустой бланк" Classes="mainBtn"/>
					<Button Content="Составить" Classes="mainBtn"/>
				</StackPanel>
			</StackPanel>
        </Border>
    </Design.PreviewWith>

	<Style Selector="Button">
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="#08F0E9"/>
		<Setter Property="CornerRadius" Value="25"/>
	</Style>

	<Style Selector="Button.mainBtn">
		<Setter Property="Margin" Value="25,50,25,50"/>
		<Setter Property="Width" Value="600"/>
		<Setter Property="Height" Value="75"/>
		<Setter Property="FontSize" Value="44"/>
	</Style>
</Styles>
