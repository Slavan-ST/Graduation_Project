<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="25">
			<TextBox Classes="revealPasswordButton" Text="123454545542452dfgdfgdfgdfgdf45245245" VerticalContentAlignment="Center" PasswordChar="*" Height="80"/>
        </Border>
    </Design.PreviewWith>

	<Style Selector="TextBox.revealPasswordButton PathIcon">
		<Style.Animations>
			<Animation Duration="0:0:01"
					   IterationCount="Infinite">
				<KeyFrame Cue="0%">
					<Setter Property="Height" Value="50"/>
					<Setter Property="Width" Value="50"/>
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="Height" Value="50"/>
					<Setter Property="Width" Value="50"/>
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>
</Styles>