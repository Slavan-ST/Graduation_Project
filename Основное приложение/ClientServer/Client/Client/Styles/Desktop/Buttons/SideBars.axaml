<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<StackPanel Spacing="10">
				<Button Content="InSideBar (sideBar)" Classes="sideBar"/>
				<Button Content="◄" Classes="switch"/>
			</StackPanel>
        </Border>
    </Design.PreviewWith>

	<StyleInclude Source="/Styles/Main/Buttons.axaml"/>

	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Styles/Resources/Colors.axaml"/>
				<ResourceInclude Source="/Styles/Resources/BorderValue.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>

	<Style Selector="Button.sideBar">
		<Setter Property="Background" Value="{StaticResource lightBlue}"/>
		<Setter Property="BorderBrush" Value="{StaticResource purple}"/>
		<Setter Property="BorderThickness" Value="{StaticResource thicknessValue}"/>
		<Setter Property="CornerRadius" Value="{StaticResource cornerRadiusValue}"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Margin" Value="5"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.switch">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="{StaticResource cornerRadiusValue}"/>
		<Setter Property="Height" Value="40"/>
		<Setter Property="Width" Value="35"/> 
	</Style>
	
</Styles>
