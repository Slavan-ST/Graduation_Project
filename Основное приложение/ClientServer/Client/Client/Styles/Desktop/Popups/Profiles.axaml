<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<UserControl Classes="profile">
				<Grid>
					<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
					<StackPanel Margin="10">
						<StackPanel Orientation="Horizontal" Margin="15">
							<StackPanel Margin="10">
								<TextBlock Text="{Binding Fio}" Classes="h2"/>
								<TextBlock Text="{Binding NumberRoom}" Classes="h2"/>
								<TextBlock Text="{Binding MarkClear}" Classes="h2"/>
								<TextBlock Text="{Binding StatusUser}" Classes="h2"/>
							</StackPanel>
						</StackPanel>
						<TextBlock Text="Дополнительная информация" Classes="h2"/>
						<StackPanel Margin="15" HorizontalAlignment="Stretch">
							<StackPanel>
								<TextBlock Text="Контакты" Classes="h3"/>
								<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
							</StackPanel>
							<StackPanel>
								<TextBlock Text="Домашний адрес" Classes="h3"/>
								<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
							</StackPanel>
							<StackPanel>
								<TextBlock Text="Группа" Classes="h3"/>
								<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
							</StackPanel>
							<TextBlock Text="Информация о законных предствителях" Classes="h2"/>
							<StackPanel>
								<TextBlock Text="ФИО" Classes="h3"/>
								<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
							</StackPanel>
							<StackPanel>
								<TextBlock Text="Номер телефона" Classes="h3"/>
								<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Grid>
			</UserControl>
        </Border>
    </Design.PreviewWith>

	<Style Selector="UserControl.profile">
		<Setter Property="Background" Value="White"/>
		<Setter Property="Height" Value="600"/>
		<Setter Property="Width" Value="800"/>
	</Style>
	
</Styles>
