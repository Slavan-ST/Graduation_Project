<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<Border Classes="combineOutline">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Всего: " Classes="h4"/>
					<TextBlock Text="123" Classes="h4"/>
				</StackPanel>
			</Border>
        </Border>
    </Design.PreviewWith>
	
	<StyleInclude Source="/Styles/Main/TextBlocks.axaml"/>
	<StyleInclude Source="/Styles/Desktop/TextBlocks/Headers.axaml"/>
	
	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Styles/Resources/BorderValue.axaml"/>
				<ResourceInclude Source="/Styles/Resources/Colors.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>
		
		
	<Style Selector="Border.combineOutline">
		<Setter Property="Margin" Value="10"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="{StaticResource purple}"/>
		<Setter Property="BorderThickness" Value="{StaticResource thicknessValue}"/>
		<Setter Property="CornerRadius" Value="{StaticResource cornerRadiusValue}"/>
		<Setter Property="Padding" Value="10,0,10,0"/>
	</Style>	

</Styles>
