<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<StackPanel>
				<TextBlock Text="Header (h1)" Classes="h1"/>
				<TextBlock Text="Header (h2)" Classes="h2"/>
			</StackPanel>
        </Border>
    </Design.PreviewWith>

	<StyleInclude Source="/Styles/Main/TextBlocks.axaml"/>
	
	<Style Selector="TextBlock.h1">
		<Setter Property="FontSize" Value="40"/>
	</Style>

	<Style Selector="TextBlock.h2">
		<Setter Property="FontSize" Value="36"/>
	</Style>
</Styles>
