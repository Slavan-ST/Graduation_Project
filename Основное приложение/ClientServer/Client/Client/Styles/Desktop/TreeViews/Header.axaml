<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Width="600" Height="800">
			<TreeView Classes="transparent faq">
				<TreeViewItem Header="Header 1" Classes="h1">
					<TextBlock Text="Item 1" Classes="h1"/>
				</TreeViewItem>
				<TreeViewItem Header="Header 2" Classes="h1">
					<TextBlock Text="Item 2" Classes="h2"/>
				</TreeViewItem>
				<TreeViewItem Header="Header 3" Classes="h1">
					<TextBlock Text="Item 3" Classes="h3"/>
				</TreeViewItem>
				<TreeViewItem Header="Header 4" Classes="h1">
					<TextBlock Text="Item 4" Classes="h4"/>
				</TreeViewItem>
			</TreeView>
        </Border>
    </Design.PreviewWith>

	<StyleInclude Source="/Styles/Desktop/TreeViews/Headers.axaml"/>
	<StyleInclude Source="/Styles/Desktop/TextBlocks/Headers.axaml"/>

	
	<Style Selector="TreeView.transparent TreeViewItem:pointerover Border#PART_LayoutRoot">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="TreeView.transparent TreeViewItem:selected Border#PART_LayoutRoot">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="TreeView.transparent.faq TreeViewItem">
		<Setter Property="Margin" Value="35"/>
		<Setter Property="FontSize" Value="42"/>
	</Style>
	
</Styles>
