<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<StackPanel Height="280" Width="280">
				<TextBlock Text="Mount" Classes="title"/>
				<Border Classes="plain">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Всего " Classes="titleInItems"/>
						<TextBlock Text="CountAll" Classes="titleInItems"/>
					</StackPanel>
				</Border>
				<Border Classes="plain">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Всего " Classes="titleInItems"/>
						<TextBlock Text="CountAll" Classes="titleInItems"/>
					</StackPanel>
				</Border>
				<Border Classes="plain">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Всего " Classes="titleInItems"/>
						<TextBlock Text="CountAll" Classes="titleInItems"/>
					</StackPanel>
				</Border>
			</StackPanel>
        </Border>
    </Design.PreviewWith>
	
	
	<Style Selector="Border.plain">
		<Setter Property="Padding" Value="2"/>
		<Setter Property="BorderBrush" Value="#A378EB"/>
		<Setter Property="BorderThickness" Value="4"/>
		<Setter Property="CornerRadius" Value="25"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Margin" Value="10"/>
	</Style>

	<Style Selector="TextBlock.titleInItems">
		<Setter Property="FontSize" Value="24"/>
	</Style>
	
	
</Styles>
