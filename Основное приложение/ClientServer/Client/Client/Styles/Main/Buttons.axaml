<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<Button Content="123"/>
        </Border>
    </Design.PreviewWith>

	<Style Selector="Button">
		<Setter Property="FontFamily" Value="Inter"/>
		<Setter Property="FontSize" Value="24"/>
	</Style>
	
</Styles>
