<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20" Background="rgb(0,0,0,0.5)">
			<Ellipse Classes="spinner"/>
		</Border>
	</Design.PreviewWith>

	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Styles/Resources/Colors.axaml"/>
				<ResourceInclude Source="/Styles/Resources/BorderValue.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>

	<Style Selector="Ellipse">
		<Setter Property="Stroke" Value="{StaticResource lightBlue}"/>
		<Setter Property="StrokeThickness" Value="5"/>
		<Setter Property="StrokeDashArray" Value="10"/>
		<Setter Property="Height" Value="50"/>
		<Setter Property="Width" Value="50"/>
		<Style.Animations>
			<Animation Duration="0:0:1" IterationCount="Infinite">
				<KeyFrame Cue="0%">
					<Setter Property="RotateTransform.Angle" Value="0"/>
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="RotateTransform.Angle" Value="360"/>
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>
</Styles>
