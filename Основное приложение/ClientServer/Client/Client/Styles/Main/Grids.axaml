<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<Grid Classes="gradientFill"  Width="300" Height="20">
				
			</Grid>
        </Border>
    </Design.PreviewWith>

	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Styles/Resources/Colors.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>

	<Style Selector="Grid.gradientFill">
		<Setter Property="Background" Value="{StaticResource gradientLightBlueToPurple}"/>
	</Style>
	
</Styles>
