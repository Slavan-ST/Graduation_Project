<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:rxui="http://reactiveui.net"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ir="clr-namespace:Avalonia.Xaml.Interactions.Responsive;assembly=Avalonia.Xaml.Interactions.Responsive"
			 xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 xmlns:iac="clr-namespace:Avalonia.Xaml.Interactions.Custom;assembly=Avalonia.Xaml.Interactions.Custom"
			 xmlns:vm="clr-namespace:Client.ViewModels"
			 xmlns:views="clr-namespace:Client.Views;assembly=Client"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Client.Views.MainMenuView">

	<Grid PointerPressed="Grid_PointerPressed">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.ColumnSpan="2" Name="TitlePlace">
			<Grid.Background>
				<LinearGradientBrush>
					<GradientStop Color="#070268" Offset="0"/>
					<GradientStop Color="#08F0E9" Offset="1"/>
				</LinearGradientBrush>
			</Grid.Background>
			<TextBlock Text="{Binding Title}" HorizontalAlignment="Right"
					   VerticalAlignment="Center"
					   Margin="5" Classes="title"/>
			<Button Width="40" Height="40" Margin="5" 
					HorizontalAlignment="Left" Command="{Binding OpenSideBar}"/>
		</Grid>



		<rxui:RoutedViewHost Router="{Binding Router}"
					 DockPanel.Dock="Bottom" Grid.ColumnSpan="2"
					 Grid.Column="{Binding NumColumn}"
					 Grid.Row="1" x:Name="UCworkPlace">
			<rxui:RoutedViewHost.DefaultContent>
				<TextBlock Text="Default content"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center" />
			</rxui:RoutedViewHost.DefaultContent>
		</rxui:RoutedViewHost>
		
		
		
		<Grid Grid.RowSpan="2" IsVisible="{Binding IsOpenSideBar}" Background="White">
			<StackPanel Margin="25">
				<Button Content="На главную" IsVisible="{Binding !IsMain}" Command="{Binding OnMain}" Classes="main"/>
				<StackPanel IsVisible="{Binding IsStudents}">
					<Button Content="Профиль" Command="{Binding Profile}" Classes="main"/>
					<Button Content="Заявление" Command="{Binding Statement}" Classes="main"/>
					<Button Content="Мероприятия" Command="{Binding Events}" Classes="main"/>
				</StackPanel>
				<StackPanel IsVisible="{Binding IsWorker}">
					<Button Content="План меропритий" Command="{Binding EventsList}" Classes="main"/>
					<Button Content="График дежурств" Command="{Binding DutyChart}" Classes="main"/>
					<Button Content="Списки студентов" Command="{Binding ListStudents}" Classes="main"/>
					<Button Content="Экран чистоты" Command="{Binding PurityChart}" Classes="main"/>
					<Button Content="Журнал" Command="{Binding Record}" Classes="main"/>
					<Button Content="Рейд чистоты" Command="{Binding CleanRaid}" Classes="main"/>
					<Button Content="Ежедневная проверка" Command="{Binding DailyCheck}" Classes="main"/>
				</StackPanel>
				<Button Content="Вопрос-ответ" Command="{Binding Faq}" Classes="main"/>
			</StackPanel>
			<Button Content="◄" Classes="back" Command="{Binding HideSideBar}"/>
		</Grid>
	</Grid>
</UserControl>
