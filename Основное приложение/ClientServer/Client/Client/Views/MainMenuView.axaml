<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:rxui="http://reactiveui.net"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ir="clr-namespace:Avalonia.Xaml.Interactions.Responsive;assembly=Avalonia.Xaml.Interactions.Responsive"
			 xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 xmlns:iac="clr-namespace:Avalonia.Xaml.Interactions.Custom;assembly=Avalonia.Xaml.Interactions.Custom"
			 xmlns:vm="clr-namespace:Client.ViewModels"
			 xmlns:views="clr-namespace:Client.Views;assembly=Client"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Client.Views.MainMenuView">

	<Grid PointerPressed="Grid_PointerPressed">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.ColumnSpan="2" Name="TitlePlace" Classes="gradientFill">
			<TextBlock Text="{Binding Title}" HorizontalAlignment="Right"
					   VerticalAlignment="Center"
					   Margin="5" Classes="h1"/>
			<Button Width="40" Height="40" Margin="5"
					HorizontalAlignment="Left" Command="{Binding OpenSideBar}">
				<Image Source="{SvgImage /Assets/sideBarBtn.svg}" Stretch="UniformToFill"/>
			</Button>
		</Grid>



		<rxui:RoutedViewHost Router="{Binding Router}"
					 DockPanel.Dock="Bottom" Grid.ColumnSpan="2"
					 Grid.Column="{Binding NumColumn}"
					 Grid.Row="1" x:Name="UCworkPlace">
			<rxui:RoutedViewHost.DefaultContent>
				<TextBlock Text="Default content"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center" />
			</rxui:RoutedViewHost.DefaultContent>
		</rxui:RoutedViewHost>

		<Grid Grid.Column="1" Grid.RowSpan="2">
			<Border Background="rgba(0, 0, 0, 0.3)" IsVisible="{Binding IsOpenSideBar}"/>
		</Grid>

			<Grid Grid.RowSpan="2" IsVisible="{Binding IsOpenSideBar}" Background="White">
				<StackPanel Margin="25">
					<Button Content="На главную" IsVisible="{Binding !IsMain}" Command="{Binding OnMain}" Classes="sideBar"/>
					<StackPanel IsVisible="{Binding IsStudents}">
						<!-- Временно не надо !!<Button Content="Профиль" Command="{Binding Profile}" Classes="sideBar"/>-->
						<Button Content="Заявление" Command="{Binding Statement}" Classes="sideBar"/>
						<Button Content="Мероприятия" Command="{Binding Events}" Classes="sideBar"/>
					</StackPanel>
					<StackPanel IsVisible="{Binding IsWorker}">
						<Button Content="План мероприятий" Command="{Binding EventsList}" Classes="sideBar"/>
						<Button Content="График дежурств" Command="{Binding DutyChart}" Classes="sideBar"/>
						<Button Content="Списки студентов" Command="{Binding ListStudents}" Classes="sideBar"/>
						<Button Content="Экран чистоты" Command="{Binding PurityChart}" Classes="sideBar"/>
						<Button Content="Журнал" Command="{Binding Record}" Classes="sideBar"/>
						<Button Content="Рейд чистоты" Command="{Binding CleanRaid}" Classes="sideBar"/>
						<Button Content="Ежедневная проверка" Command="{Binding DailyCheck}" Classes="sideBar"/>
					</StackPanel>
					<Button Content="Вопрос-ответ" Command="{Binding Faq}" Classes="sideBar"/>
				</StackPanel>
				<Button Content="◄" Classes="switch" HorizontalAlignment="Right" Command="{Binding HideSideBar}"/>
			</Grid>
	</Grid>
</UserControl>
