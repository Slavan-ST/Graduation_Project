<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.RoomView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto"/>
		</Grid.RowDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<ScrollViewer>
			<ListBox ItemsSource="{Binding Rooms}" Background="Transparent"
					 HorizontalAlignment="Center" SelectedItem="{Binding SelectedRoom}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel>

						</WrapPanel>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Classes="borderPanel">
							<Border Padding="10">
								<Grid>
									<StackPanel Classes="panel" Height="280" Width="280">
										<StackPanel>
											<TextBlock Text="Комната" Classes="h3" Margin="25,0,25,0"/>
											<TextBox Text="{Binding Number}" Classes="h3 outline purple"/>
											<StackPanel Orientation="Horizontal" Margin="25,0,25,0">
												<TextBlock Text="В комнате " Classes="h3"/>
												<TextBlock Text="{Binding CountStudents}" Classes="h3"/>
												<TextBlock Text=" чел." Classes="h3"/>
											</StackPanel>
										</StackPanel>
									</StackPanel>
									<Button Content="X"
										   Classes="delete h4"
										   Command="{Binding $parent[UserControl].DataContext.Delete}"
										   CommandParameter="{Binding Id}"/>
								</Grid>
							</Border>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</ScrollViewer>
		<Border Grid.Row="2" Background="White">
			<StackPanel Orientation="Horizontal" Margin="15" HorizontalAlignment="Right" Spacing="5">
				<Button Content="Новая комната" Classes="navigate h2" Command="{Binding NewRoom}"/>
				<Button Content="Сохранить изменения" Classes="navigate h2" Command="{Binding Save}"/>
			</StackPanel>
		</Border>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.RowSpan="2">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
