<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Client.ViewModels;assembly=Client"
			 xmlns:models="clr-namespace:Client.Models;assembly=Client"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.RecordStudentsView">
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<StackPanel>
			<TreeView>
				<TreeViewItem Header="Фильтры">
					<StackPanel Orientation="Horizontal">
						<StackPanel>
							<TextBlock Text="Студент"/>
							<AutoCompleteBox/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Комната"/>
							<AutoCompleteBox/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Статус"/>
							<AutoCompleteBox/>
						</StackPanel>
						<DatePicker DayVisible="False">
						</DatePicker>
						<Button Content="Применить"/>
					</StackPanel>
				</TreeViewItem>
			</TreeView>

			<models:HackPanel>
				<TreeDataGrid Source="{Binding Source}" Background="White"/>
			</models:HackPanel>
			
		</StackPanel>
		
	</Grid>
	
</UserControl>
