<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:bh="using:Client.Behaviours"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             xmlns:iac="clr-namespace:Avalonia.Xaml.Interactions.Custom;assembly=Avalonia.Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.ListStudentsView">
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<DockPanel>
			<TreeView DockPanel.Dock="Top" Classes="trasnparent">
				<TreeViewItem Header="Фильтры">
					<StackPanel >
						<StackPanel>
							<TextBlock Text="Студент" Classes="h3"/>
							<AutoCompleteBox ItemsSource="{Binding ListStudents}"
											 FilterMode="StartsWith"
											 Classes="outline lightBlue h4"
											 SelectedItem="{Binding ListStudentsSelectedItem}">
								<i:Interaction.Behaviors>
									<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
								</i:Interaction.Behaviors>
								<AutoCompleteBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding FIO}" Classes="h4"/>
									</DataTemplate>
								</AutoCompleteBox.ItemTemplate>
							</AutoCompleteBox>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Комната" Classes="h3"/>
							<AutoCompleteBox SelectedItem="{Binding ListRoomsSelectedItem}"
											  Classes="outline lightBlue h4">
								<i:Interaction.Behaviors>
									<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
								</i:Interaction.Behaviors>
								<AutoCompleteBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Number}" Classes="h4"/>
									</DataTemplate>
								</AutoCompleteBox.ItemTemplate>
							</AutoCompleteBox>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Статус" Classes="h3"/>
							<AutoCompleteBox SelectedItem="{Binding ListStatusesSelectedItem}"
											 Classes="outline lightBlue h4">
								<i:Interaction.Behaviors>
									<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
								</i:Interaction.Behaviors>
								<AutoCompleteBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Name}" Classes="h4"/>
									</DataTemplate>
								</AutoCompleteBox.ItemTemplate>
							</AutoCompleteBox>
						</StackPanel>
						<DatePicker Classes="outline purple"/>
						<Button Content="Применить" Margin="0,5" Classes="navigate h3"/>
					</StackPanel>
				</TreeViewItem>
			</TreeView>
			<ScrollViewer>
				<ListBox ItemsSource="{Binding Students}" Background="Transparent"
						 HorizontalAlignment="Center" SelectedItem="{Binding SelectedStudent}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel>

							</WrapPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Background="White"
									BorderBrush="#08F0E9"
									BorderThickness="5">
								<StackPanel Margin="20" Width="300" Height="250">
									<Label Content="{Binding Surname}" Classes="plainText"/>
									<Label Content="{Binding Name}" Classes="plainText"/>
									<Label Content="{Binding Patronymic}" Classes="plainText"/>
									<Label Content="{Binding Room.Number}" Classes="plainText"/>
								</StackPanel>
								<i:Interaction.Behaviors>
									<ia:EventTriggerBehavior EventName="PointerPressed" SourceObject="Border">
										<iac:PopupAction>
											<Border Classes="borderPanel">
												<UserControl Content="{Binding StudentProfil}"/>
											</Border>
										</iac:PopupAction>
									</ia:EventTriggerBehavior>
								</i:Interaction.Behaviors>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
		</ScrollViewer>
		</DockPanel>
	</Grid>
</UserControl>
