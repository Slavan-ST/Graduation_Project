<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:bh="using:Client.Behaviours"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             xmlns:iac="clr-namespace:Avalonia.Xaml.Interactions.Custom;assembly=Avalonia.Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.ListStudentsView">
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<DockPanel>
			<TreeView DockPanel.Dock="Top" Classes="transparent" >
				<TreeViewItem Header="Фильтры">
					<StackPanel Margin="10">
						<StackPanel>
							<TextBlock Text="Студент" Classes="h3"/>
							<AutoCompleteBox ItemsSource="{Binding ListStudents}"
											 FilterMode="StartsWith"
											 Classes="outline lightBlue h4"
											 SelectedItem="{Binding ListStudentsSelectedItem}">
								<i:Interaction.Behaviors>
									<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
								</i:Interaction.Behaviors>
								<AutoCompleteBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding FIO}" Classes="h4"/>
									</DataTemplate>
								</AutoCompleteBox.ItemTemplate>
							</AutoCompleteBox>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Комната" Classes="h3"/>
							<AutoCompleteBox ItemsSource="{Binding ListRooms}"
												SelectedItem="{Binding ListRoomsSelectedItem}"
											  Classes="outline lightBlue h4">
								<i:Interaction.Behaviors>
									<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
								</i:Interaction.Behaviors>
								<AutoCompleteBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Number}" Classes="h4"/>
									</DataTemplate>
								</AutoCompleteBox.ItemTemplate>
							</AutoCompleteBox>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="Статус" Classes="h3"/>
							<AutoCompleteBox ItemsSource="{Binding ListStatuses}"
											 SelectedItem="{Binding ListStatusesSelectedItem}"
											 Classes="outline lightBlue h4">
								<i:Interaction.Behaviors>
									<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
								</i:Interaction.Behaviors>
								<AutoCompleteBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Name}" Classes="h4"/>
									</DataTemplate>
								</AutoCompleteBox.ItemTemplate>
							</AutoCompleteBox>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="10">
							<Button Content="Применить" Margin="0,0,5,0" Classes="navigate h3" Command="{Binding AcceptFilters}"/>
							<Button Content="Сбросить" Margin="5,0" Classes="navigate h3" Command="{Binding ClearFilters}"/>
						</StackPanel>
					</StackPanel>
				</TreeViewItem>
			</TreeView>
			<ScrollViewer>
				<ListBox ItemsSource="{Binding Students}" Background="Transparent"
						 HorizontalAlignment="Center" SelectedItem="{Binding SelectedStudent}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel>

							</WrapPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Classes="borderPanel">
								<StackPanel Classes="panel" Height="280" Width="280">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="Комната - " Classes="h3"/>
										<TextBlock Text="{Binding Room.Number}" Classes="h3"/>
									</StackPanel>
									<TextBlock Text="{Binding Surname}" Classes="h3"/>
									<TextBlock Text="{Binding Name}" Classes="h3"/>
									<TextBlock Text="{Binding Patronymic}" Classes="h3"/>
								</StackPanel>
								<i:Interaction.Behaviors>
									<ia:EventTriggerBehavior EventName="PointerPressed" SourceObject="Border">
										<iac:PopupAction>
											<Border Classes="borderPanel">
												<UserControl Content="{Binding StudentProfil}" Classes="profile"/>
											</Border>
										</iac:PopupAction>
									</ia:EventTriggerBehavior>
								</i:Interaction.Behaviors>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
		</ScrollViewer>
		</DockPanel>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
