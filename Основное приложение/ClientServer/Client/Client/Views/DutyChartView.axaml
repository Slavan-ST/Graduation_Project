<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="using:Client.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Client.Views.DutyChartView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="7*"/>
		</Grid.RowDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.RowSpan="2"/>
		<StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
				<Button Classes="switch" Command="{Binding MonthPrev}">
					<Image Source="{SvgImage /Assets/light/leftBtn.svg}" Stretch="UniformToFill"/>
				</Button>
				<TextBlock Text="{Binding MonthString}" Classes="h2" 
						   VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="50"/>
				<Button Classes="switch" Command="{Binding MonthNext}">
					<Image Source="{SvgImage /Assets/light/rightBtn.svg}" Stretch="UniformToFill"/>
				</Button>
			</StackPanel>
		</StackPanel>
		<ScrollViewer Grid.Row="1">
			<ItemsControl ItemsSource="{Binding DutyItems}" HorizontalAlignment="Center">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Classes="borderPanel">
							<StackPanel Classes="panel" Height="280" Width="280">
								<TextBlock Text="{Binding ShortDate}" Classes="h3"/>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="Комната - " Classes="h3"/>
									<TextBlock Text="{Binding Student.Room.Number}" Classes="h3"/>
								</StackPanel>
								<TextBlock Text="{Binding Student.FIO}" Classes="h3" TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.RowSpan="2">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
