<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:bh="using:Client.Behaviours"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:vm="clr-namespace:Client.ViewModels;assembly=Client"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Client.Views.StatementView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="2.75*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.RowSpan="2" Grid.ColumnSpan="3"/>
		<ScrollViewer  Grid.Column="1">
			<StackPanel HorizontalAlignment="Stretch" Margin="40" >
				<StackPanel Margin="10">
					<TextBlock Text="Cтудент" Classes="h2"></TextBlock>

					<AutoCompleteBox ItemsSource="{Binding ListStudents}"
											 FilterMode="StartsWith"
											 Classes="outline lightBlue h4"
											 SelectedItem="{Binding ListStudentsSelectedItem}">
						<i:Interaction.Behaviors>
							<bh:AutoCompleteZeroMinimumPrefixLengthDropdownBehaviour/>
						</i:Interaction.Behaviors>
						<AutoCompleteBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding FIO}" Classes="h4"/>
							</DataTemplate>
						</AutoCompleteBox.ItemTemplate>
					</AutoCompleteBox>


					<TextBlock Text="Дата выезда" Classes="h3"/>
					<TextBox Text="{Binding DateOut}" Classes="outline purple h3"/>


					<TextBlock Text="Дата заезда" Classes="h3"/>
					<TextBox Text="{Binding DateIn}" Classes="outline purple h3"/>

				</StackPanel>
			</StackPanel>
		</ScrollViewer>
		<Border Background="White"  Grid.Row="1" Grid.ColumnSpan="3">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15" Spacing="5">
			<Button Command="{Binding GetEmptyStatement}" Content="Получить пустой бланк" Classes="navigate h2"/>
			<Button Command="{Binding GetFillStatement}" Content="Составить" Classes="navigate h2"/>
		</StackPanel>
		</Border>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.RowSpan="2" Grid.ColumnSpan="3">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
