<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.EventsView">
	<UserControl.Styles>
		<StyleInclude Source="/Styles/TextBlocks/MainTextBlock.axaml"/>
		<StyleInclude Source="/Styles/TextBlocks/EventsMenu.axaml"/>
	</UserControl.Styles>
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<ScrollViewer VerticalScrollBarVisibility="Hidden">
			<ItemsControl ItemsSource="{Binding Events}" Background="Transparent" 
						  HorizontalAlignment="Center">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel>

						</WrapPanel>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<DockPanel LastChildFill="True" MinWidth="500" MinHeight="400" Margin="45" 
								   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
								<TextBlock Text="{Binding Name}" Classes="header"/>
								<Grid Height="35" Width="35" Margin="5">
									<Image Source="{SvgImage /Assets/light/bell.svg}"/>
									<ToggleButton Background="Transparent"
												  HorizontalAlignment="Stretch"
												  VerticalAlignment="Stretch"/>
								</Grid>
							</StackPanel>
							<Border CornerRadius="25" Background="rgba(8, 255, 248, 0.45)">
								<StackPanel Margin="20">
									<Label Content="{Binding Date}" Classes="plainText"></Label>
									<Label Content="{Binding Place}" Classes="plainText"/>
									<Label Content="{Binding Employes}" Classes="plainText"/>
									<Label Content="{Binding Description}" Classes="plainText"/>
								</StackPanel>
							</Border>
						</DockPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
