<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.EventsListView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="7*"/>
		</Grid.RowDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.RowSpan="2"/>
		<StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
				<Button Content="◄" Classes="switch"/>
				<TextBlock Text="Месяц" Classes="h2" VerticalAlignment="Center"/>
				<Button Content="►" Classes="switch"/>
			</StackPanel>
		</StackPanel>
		<ScrollViewer Grid.Row="1">
			<ItemsControl ItemsSource="{Binding Events}" Background="Transparent"
						  HorizontalAlignment="Center">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Classes="borderPanel">
							<StackPanel Classes="panel" MinWidth="300" MinHeight="400">
								<TextBox Text="{Binding Name}" Classes="h4 outline purple"/>
								<TextBox Text="{Binding Date}" Classes="h4 outline purple"/>
								<TextBox Text="{Binding Location}" Classes="h4 outline purple"/>
								<TextBox Text="{Binding Organizer}" Classes="h4 outline purple"/>
								<TextBox Text="{Binding Description}" Classes="h4 outline purple" TextWrapping="Wrap"/>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
