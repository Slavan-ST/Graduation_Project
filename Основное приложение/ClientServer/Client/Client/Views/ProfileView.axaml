<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Client.Views.ProfileView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="3*"/>
		</Grid.RowDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.RowSpan="2"/>
		<StackPanel Margin="25">
			<TextBlock Text="{Binding Fio}" Classes="h2"/>
			<TextBlock Text="{Binding NumberRoom}" Classes="h2"/>
			<TextBlock Text="{Binding MarkClear}" Classes="h2"/>
			<TextBlock Text="{Binding StatusUser}" Classes="h2"/>
		</StackPanel>
		<ScrollViewer Grid.Row="1" Margin="25">
			<StackPanel HorizontalAlignment="Stretch">
				<TextBlock Text="Дополнительная информация" Classes="h2"/>
				<StackPanel Margin="10">
					<StackPanel>
						<TextBlock Text="Контакты" Classes="h3"/>
						<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
					</StackPanel>
					<StackPanel>
						<TextBlock Text="Домашний адрес" Classes="h3"/>
						<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
					</StackPanel>
					<StackPanel>
						<TextBlock Text="Группа" Classes="h3"/>
						<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
					</StackPanel>
				</StackPanel>

				<TextBlock Text="Информация о законных предствителях" Classes="h2"/>
				<StackPanel Margin="10">
					<StackPanel>
						<TextBlock Text="ФИО" Classes="h3"/>
						<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
					</StackPanel>
					<StackPanel>
						<TextBlock Text="Номер телефона" Classes="h3"/>
						<TextBox Classes="outline purple h3" Text="{Binding TestText}"/>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.RowSpan="2">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
