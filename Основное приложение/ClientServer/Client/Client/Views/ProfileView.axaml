<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Client.Views.ProfileView">
	<UserControl.Styles>
		<StyleInclude Source="/Styles/TextBlocks/MainTextBlock.axaml"/>
		<StyleInclude Source="/Styles/TextBlocks/ProfileTitles.axaml"/>
	</UserControl.Styles>
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<StackPanel>
			<StackPanel Orientation="Horizontal" Margin="50">
				<StackPanel Margin="15">
					<TextBlock Text="{Binding Fio}" Classes="dataStudents"/>
					<TextBlock Text="{Binding NumberRoom}" Classes="dataStudents"/>
					<TextBlock Text="{Binding MarkClear}" Classes="dataStudents"/>
					<TextBlock Text="{Binding StatusUser}" Classes="dataStudents"/>
				</StackPanel>
			</StackPanel>
			<Label Content="Дополнительная информация" Classes="header"/>
			<StackPanel Margin="50" HorizontalAlignment="Stretch">
				<Border Classes="up">
					<StackPanel Orientation="Horizontal">
						<Label Content="Контакты" Classes="textElement"/>
						<TextBox Classes="h3" Text="{Binding TestText}"/>
					</StackPanel>
				</Border>
				<Border Classes="up">
					<StackPanel Orientation="Horizontal">
						<Label Content="Домашний адрес" Classes="textElement"/>
						<TextBox Classes="h3" Text="{Binding TestText}"/>
					</StackPanel>
				</Border>
				<Border Classes="up">
					<StackPanel Orientation="Horizontal">
						<Label Content="Группа" Classes="textElement"/>
						<TextBox Classes="h3" Text="{Binding TestText}"/>
					</StackPanel>
				</Border>
				<Border Classes="up">
					<StackPanel Orientation="Horizontal">
						<Label Content="Информация о законных предствителях" Classes="textElement"/>
						<TextBox Classes="h3" Text="{Binding TestText}"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</StackPanel>
	</Grid>
</UserControl>
