<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.FaqView">
	<UserControl.Styles>
		<StyleInclude Source="/Styles/TreeViews/TreeViewItem.axaml"/>
	</UserControl.Styles>
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill"/>
		<TreeView ItemsSource="{Binding QuestAnswer}" >
			<TreeView.ItemTemplate>
				<TreeDataTemplate ItemsSource="{Binding Answers}">
					<TextBlock Text="{Binding Title}" Classes="plain"/>
				</TreeDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
	</Grid>
</UserControl>
