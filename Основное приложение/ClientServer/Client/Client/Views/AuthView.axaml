<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"
             x:Class="Client.Views.AuthView">
	<Grid>
		<Image Source="{SvgImage /Assets/light/foneAuth.svg}" Stretch="UniformToFill"/>
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
				    Margin="0,250,0,0">
			<TextBlock Text="Добро пожаловать!" Classes="h3"/>
			<TextBlock Text="Чтобы продолжить, авторизируйтесь" Classes="h2"/>
			<TextBox Watermark="Логин" Text="{Binding Login}" Classes="outline lightBlue"/>
			<TextBox PasswordChar="•" Classes="revealPasswordButton outline lightBlue"
					 Watermark="Пароль" Text="{Binding Password}"/>
			<Button Content="Войти" Command="{Binding Auth}" Classes="navigate"/>
		</StackPanel>
	</Grid>
</UserControl>
