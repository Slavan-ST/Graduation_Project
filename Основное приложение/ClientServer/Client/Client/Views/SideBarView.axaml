<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.SideBarView">
	<UserControl.Styles>
		<StyleInclude Source="/Styles/Buttons/SideBar.axaml"/>
		<StyleInclude Source="/Styles/Buttons/BackButton.axaml"/>
	</UserControl.Styles>
	<Grid>
		<StackPanel Margin="25">
			<Button Content="На главную" IsVisible="{Binding !IsMain}" Command="{Binding OnMain}"/>
			<StackPanel IsVisible="{Binding IsStudents}">
				<Button Content="Профиль" Command="{Binding Profile}"/>
				<Button Content="Заявление" Command="{Binding Statement}"/>
				<Button Content="Мероприятия" Command="{Binding Events}"/>
			</StackPanel>
			<StackPanel IsVisible="{Binding IsWorker}">
				<Button Content="План меропритий" Command="{Binding EventsList}"/>
				<Button Content="График дежурств" Command="{Binding DutyChart}"/>
				<Button Content="Списки студентов" Command="{Binding ListStudents}"/>
				<Button Content="Экран чистоты" Command="{Binding PurityChart}"/>
			</StackPanel>
			<Button Content="Вопрос-ответ" Command="{Binding Faq}"/>
		</StackPanel>
		<Button Classes="back" Command="{Binding HideSideBar}"/>
	</Grid>
</UserControl>
