<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.RestorePasswordView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="2.75*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.ColumnSpan="3" Grid.RowSpan="2"/>
		<StackPanel Grid.Column="1" Margin="0,20,0,0">
			<TextBlock Text="Логин" Classes="h2" Margin="25,0,25,0"/>
			<TextBox Text="{Binding Login}" Classes="h2 outline purple"/>

			<TextBlock Text="Новый пароль" Classes="h2" Margin="25,0,25,0"/>
			<TextBox Text="{Binding NewPassword}" Classes="h2 outline purple"/>
		</StackPanel>
		<Border Grid.Row="2" Background="White" Grid.ColumnSpan="3">
			<StackPanel Orientation="Horizontal" Margin="15" HorizontalAlignment="Right" Spacing="5">
				<Button Content="Восстановить пароль" Classes="navigate h2" Command="{Binding Restore}"/>
			</StackPanel>
		</Border>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.RowSpan="2" Grid.ColumnSpan="3">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
