<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClientAvalonia.ViewModels"
			 xmlns:capthc="using:Captcha"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClientAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

	<Grid Margin="40">
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition Height="3*"/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition Height="3*"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<capthc:Captcha MinWidth="300"
					  VerticalAlignment="Stretch"
					  HorizontalAlignment="Stretch"
				      Grid.Row="4"/>

		<TextBlock Text="Сообщение серверу" 
				   Grid.Row="0"/>
		<TextBox MinWidth="200" 
				 Text="{Binding TextMessage}" 
				 VerticalAlignment="Stretch" 
				 HorizontalAlignment="Stretch"
				 Grid.Row="1"
				 />
		<Button Content="Send" 
				Command="{Binding Send}"
				Grid.Row="2"/>


		<Image Grid.Row="4" Source="{Binding Image}"/>
	</Grid>

	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="MinWidth" Value="200"/>
			<Setter Property="Margin" Value="10"/>
		</Style>
	</UserControl.Styles>
</UserControl>
