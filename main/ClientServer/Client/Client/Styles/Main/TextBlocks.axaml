<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
			<StackPanel>
				<TextBlock Text="Inter"/>
				<Label Content="Inter"/>
			</StackPanel>
		</Border>
    </Design.PreviewWith>

	<Style Selector="TextBlock">
		<Setter Property="FontFamily" Value="Inter"/>
	</Style>
	
	<Style Selector="Label">
		<Setter Property="FontFamily" Value="Inter"/>
	</Style>
</Styles>
