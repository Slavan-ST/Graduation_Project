<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<TextBox Text="Inter"></TextBox>
		</Border>
	</Design.PreviewWith>

	<Style Selector="TextBox">
		<Setter Property="FontFamily" Value="Inter"/>
	</Style>
</Styles>
