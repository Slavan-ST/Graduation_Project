<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<StackPanel>
				<Border Background="{StaticResource ResourceKey=purple}"
						Height="50" Width="50" CornerRadius="25" Margin="25"/>
				<Border Background="{StaticResource ResourceKey=lightBlue}"
						Height="50" Width="50" CornerRadius="25" Margin="25"/>
				<Border Background="{StaticResource ResourceKey=gradientLightBlueToPurple}"
						Height="50" Width="500" CornerRadius="25" Margin="25"/>
				<Border Background="{StaticResource ResourceKey=lightBlueAlpha}"
						Height="50" Width="50" CornerRadius="25" Margin="25"/>
			</StackPanel>
		</Border>
	</Design.PreviewWith>
	<SolidColorBrush x:Key="purple" Color="#A378EB"/>
	<SolidColorBrush x:Key="lightBlue" Color="#08F0E9"/>
	<SolidColorBrush x:Key="lightPurple" Color="#CBADFE"/>
	<SolidColorBrush x:Key="lightBlueAlpha" Color="rgba(8, 255, 248, 0.45)"/>
	<LinearGradientBrush x:Key="gradientLightBlueToPurple">
		<GradientStop Color="#070268" Offset="0"/>
		<GradientStop Color="rgb(8,240,233,80)" Offset="1"/>
	</LinearGradientBrush>
</ResourceDictionary>
