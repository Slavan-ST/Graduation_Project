<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Width="500">
			<StackPanel>
				<TextBox Text="Header (purple)" Classes="outline purple"/>
				<TextBox Text="Header (lightBlue)" Classes="outline lightBlue"/>
			</StackPanel>
        </Border>
    </Design.PreviewWith>

	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Styles/Resources/Colors.axaml"/>
				<ResourceInclude Source="/Styles/Resources/BorderValue.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>

	<StyleInclude Source="/Styles/Main/TextBlocks.axaml"/>

	<Style Selector="TextBox.outline">
		<Setter Property="FontSize" Value="24"/>
		<Setter Property="BorderThickness" Value="{StaticResource thicknessValue}"/>
		<Setter Property="CornerRadius" Value="{StaticResource cornerRadiusValue}"/>
		<Setter Property="Padding" Value="10,0,10,0"/>
		<Setter Property="Margin" Value="10"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
	</Style>

	<Style Selector="TextBox.outline.purple">
		<Setter Property="BorderBrush" Value="{StaticResource purple}"/>
	</Style>

	<Style Selector="TextBox.outline.lightBlue">
		<Setter Property="BorderBrush" Value="{StaticResource lightBlue}"/>
	</Style>
</Styles>
