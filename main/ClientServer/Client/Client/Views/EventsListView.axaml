<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:m="using:Helper.Models.Main"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.EventsListView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="auto" MaxHeight="100"/>
		</Grid.RowDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.RowSpan="2"/>
		<ScrollViewer>
			<ItemsControl ItemsSource="{Binding Events}" Background="Transparent"
						  HorizontalAlignment="Center" Grid.Column="1">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Classes="borderPanel">
							<Grid>
								<StackPanel Classes="panel" MinWidth="300" MinHeight="400" MaxWidth="300" Margin="10">
									<TextBlock Text="Наименование" Classes="h4" Margin="25,0,25,0"/>
									<TextBox Text="{Binding Name}" Classes="h4 outline purple"/>
									
									<TextBlock Text="Дата" Classes="h4" Margin="25,0,25,0"/>
									<TextBox Text="{Binding ShortDateTime}" Classes="h4 outline purple"/>
									
									<TextBlock Text="Место" Classes="h4" Margin="25,0,25,0"/>
									<TextBox Text="{Binding Location}" Classes="h4 outline purple"/>
									
									<TextBlock Text="Организатор" Classes="h4" Margin="25,0,25,0"/>
									<TextBox Text="{Binding Organizer}" Classes="h4 outline purple"/>
									
									<TextBlock Text="Описание" Classes="h4" Margin="25,0,25,0"/>
									<TextBox Text="{Binding Description}" Classes="h4 outline purple" TextWrapping="Wrap"/>
								</StackPanel>
								<Button Content="X"
										Classes="delete close h2"
										Command="{Binding $parent[UserControl].DataContext.Delete}"
										CommandParameter="{Binding Id}"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		<Border Grid.Row="1" Background="White" >
			<StackPanel Orientation="Horizontal" Margin="15" HorizontalAlignment="Right" Spacing="15">
				<Button Content="Создать мероприятие" Classes="navigate h2" Command="{Binding NewEvent}"/>
				<Button Content="Сохранить изменения" Classes="navigate h2" Command="{Binding Save}"/>
			</StackPanel>
		</Border>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.RowSpan="2">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
