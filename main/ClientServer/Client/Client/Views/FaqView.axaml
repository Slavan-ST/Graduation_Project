<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.FaqView">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="2.75*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Image Source="{SvgImage /Assets/light/foneMain.svg}" Stretch="UniformToFill" Grid.ColumnSpan="3"/>
		<TreeView ItemsSource="{Binding QuestAnswer}" Classes="transparent" Grid.Column="1" Margin="0,20,0,0">
			<TreeView.ItemTemplate>
				<TreeDataTemplate ItemsSource="{Binding Answers}">
					<TextBlock Text="{Binding Title}" Classes="h4"/>
				</TreeDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
		<Border IsVisible="{Binding IsLoading}" Background="rgba(0, 0, 0, 0.5)" Grid.ColumnSpan="3">
			<Ellipse Classes="spinner"/>
		</Border>
	</Grid>
</UserControl>
