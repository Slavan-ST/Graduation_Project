<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.ProfileView">
	<StackPanel>
		<StackPanel Orientation="Horizontal" Margin="50">
			<Image Source="{Binding PhotoUser}" Stretch="Fill" Width="150" Height="150"></Image>
			<StackPanel Margin="15">
				<TextBlock Text="{Binding Fio}"/>
				<TextBlock Text="{Binding NumberRoom}"/>
				<TextBlock Text="{Binding MarkClear}"/>
				<TextBlock Text="{Binding StatusUser}"/>
			</StackPanel>
		</StackPanel>
		<StackPanel Margin="25">
			<TextBlock Text="Доп. информация"></TextBlock>
			<StackPanel Margin="15">
				<TextBlock>
					<Run>* </Run>
					<Run> Text</Run>
				</TextBlock>
				<TextBlock>
					<Run>* </Run>
					<Run> Text</Run>
				</TextBlock>
				<TextBlock>
					<Run>* </Run>
					<Run> Text</Run>
				</TextBlock>
				<TextBlock>
					<Run>* </Run>
					<Run> Text</Run>
				</TextBlock>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</UserControl>
